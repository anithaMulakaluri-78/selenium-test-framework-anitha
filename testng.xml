<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowserSuite" parallel="tests"
       thread-count="3">

<listeners>
    <listener class-name="com.selenium.listners.TestListener"/>
</listeners>
    <test name="ChromeTests">
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="com.selenium.test.LoginTest"/>
        </classes>
    </test>

    <test name="FirefoxTests">
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="com.selenium.test.LoginTest"/>
        </classes>
    </test>

    <test name="EdgeTests">
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="com.selenium.test.LoginTest"/>
        </classes>
    </test>

</suite>